<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format2.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>orocos_kdl_vendor</name>
  <version>0.1.0</version>
  <description>
    Wrapper around orocos_kdl (Kinematics and Dynamics Library), providing a
    dependency on orocos_kdl if available or building it locally (cross-compiled
    for VxWorks) if not found.
  </description>
  <maintainer email="Andrei.Kholodnyi@gmail.com">Andrei Kholodnyi</maintainer>
  <license>Apache License 2.0</license> <!-- the contents of this package are Apache 2.0 -->
  <license>LGPL-2.1</license>           <!-- orocos_kdl uses the LGPL-2.1 license -->

  <url type="repository">https://github.com/orocos/orocos_kinematics_dynamics</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>git</buildtool_depend>

  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
